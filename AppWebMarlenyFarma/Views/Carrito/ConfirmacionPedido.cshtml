@model AppWebMarlenyFarma.Models.Pedido
@{
    ViewData["Title"] = "Confirmación de Pedido - MarlenyFarma";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card text-center">
                <div class="card-body py-5">
                    <div class="mb-4"><i class="fas fa-check-circle text-success" style="font-size:4rem;"></i></div>
                    <h2 class="card-title fw-bold mb-2">¡Pedido Confirmado!</h2>
                    <p class="text-muted mb-4">Gracias por tu compra en MarlenyFarma</p>
                    <div class="alert alert-info"><strong>Número de Pedido:</strong> #@Model.PedidoId<br><strong>Fecha:</strong> @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Detalles del Envío</h6>
                            <p class="mb-2"><strong>Nombre:</strong> @Model.NombreCliente</p>
                            <p class="mb-2"><strong>Email:</strong> @Model.Email</p>
                            <p class="mb-2"><strong>Teléfono:</strong> @Model.Telefono</p>
                            <p class="mb-0"><strong>Dirección:</strong> @Model.Direccion</p>
                        </div>
                    </div>
                    <div class="card mb-4">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="table-light"><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr><td>@item.Producto?.Nombre</td><td>@item.Cantidad</td><td>S/ @item.PrecioUnitario.ToString("F2")</td><td><strong>S/ @item.Subtotal.ToString("F2")</strong></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    @{
                        var subtotal = Model.Total;
                        var igv = subtotal * 0.18m;
                        var envio = 10m;
                        var total = subtotal + igv + envio;
                    }
                    <div class="row mb-4">
                        <div class="col-md-6 text-end"><p>Subtotal:</p><p>IGV (18%):</p><p>Envío:</p><h6 class="fw-bold text-success">Total:</h6></div>
                        <div class="col-md-6"><p><strong>S/ @subtotal.ToString("F2")</strong></p><p><strong>S/ @igv.ToString("F2")</strong></p><p><strong>S/ @envio.ToString("F2")</strong></p><h5 class="text-success fw-bold">S/ @total.ToString("F2")</h5></div>
                    </div>
                    <div class="alert alert-success"><i class="fas fa-info-circle"></i> Tu pedido será procesado en las próximas 24 horas. Recibirás un email de confirmación con el número de seguimiento.</div>
                    <div><a href="@Url.Action("Index", "Home")" class="btn btn-success btn-lg"><i class="fas fa-home"></i> Volver al Inicio</a> <a href="@Url.Action("Index", "Productos")" class="btn btn-outline-success btn-lg"><i class="fas fa-shopping-bag"></i> Continuar Comprando</a></div>
                </div>
            </div>
        </div>
    </div>
</div>