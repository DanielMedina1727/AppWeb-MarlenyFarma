@model AppWebMarlenyFarma.Models.Carrito
@{
    ViewData["Title"] = "Mi Carrito - MarlenyFarma";
}
<div class="container py-5">
    <h2 class="fw-bold mb-4">Mi Carrito de Compras</h2>
    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-shopping-cart display-4 mb-3"></i>
            <p>Tu carrito está vacío</p>
            <a href="@Url.Action("Index", "Productos")" class="btn btn-success">Continuar Comprando</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th>Cantidad</th>
                                    <th>Subtotal</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td><strong>@item.Producto?.Nombre</strong><br /><small class="text-muted">@item.Producto?.Descripcion</small></td>
                                        <td>S/ @item.PrecioUnitario.ToString("F2")</td>
                                        <td>
                                            <form method="post" action="@Url.Action("ActualizarCantidad", "Carrito")" class="d-inline">
                                                <input type="hidden" name="itemId" value="@item.ItemCarritoId" />
                                                <div class="input-group" style="width: 100px;">
                                                    <input type="number" name="cantidad" class="form-control" value="@item.Cantidad" min="1" max="@item.Producto?.Stock" />
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="fas fa-sync"></i></button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="fw-bold">S/ @item.Subtotal.ToString("F2")</td>
                                        <td>
                                            <form method="post" action="@Url.Action("EliminarProducto", "Carrito")" class="d-inline">
                                                <input type="hidden" name="itemId" value="@item.ItemCarritoId" />
                                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Resumen del Carrito</h5>
                        @{
                            var subtotal = Model.ObtenerTotal();
                            var igv = subtotal * 0.18m;
                            var envio = 10m;
                            var total = subtotal + igv + envio;
                        }
                        <div class="d-flex justify-content-between mb-2"><span>Subtotal:</span><strong>S/ @subtotal.ToString("F2")</strong></div>
                        <div class="d-flex justify-content-between mb-2"><span>Envío:</span><strong>S/ @envio.ToString("F2")</strong></div>
                        <div class="d-flex justify-content-between mb-3"><span>IGV (18%):</span><strong>S/ @igv.ToString("F2")</strong></div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4"><h6>Total:</h6><h6 class="text-success">S/ @total.ToString("F2")</h6></div>
                        <a href="@Url.Action("Checkout", "Carrito")" class="btn btn-success btn-lg w-100 mb-2"><i class="fas fa-credit-card"></i> Proceder al Pago</a>
                        <a href="@Url.Action("Index", "Productos")" class="btn btn-outline-success w-100"><i class="fas fa-shopping-bag"></i> Continuar Comprando</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>