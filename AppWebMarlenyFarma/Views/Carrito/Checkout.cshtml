@model AppWebMarlenyFarma.Models.Carrito

@{
    ViewData["Title"] = "Checkout - MarlenyFarma";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">Finalizar Compra</h2>

    <div class="row">
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h2 class="h5 mb-0">Datos de Envío</h2>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("ConfirmarPedido", "Carrito")">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="nombreCliente">Nombre Completo*</label>
                                <input type="text" id="nombreCliente" name="nombreCliente" class="form-control" autocomplete="name" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="email">Email*</label>
                                <input type="email" id="email" name="email" class="form-control" autocomplete="email" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="telefono">Teléfono*</label>
                                <input type="tel" id="telefono" name="telefono" class="form-control" autocomplete="tel" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="direccion">Dirección de Entrega*</label>
                                <input type="text" id="direccion" name="direccion" class="form-control" autocomplete="street-address" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="notas">Notas (Opcional)</label>
                            <textarea id="notas" name="notas" class="form-control" rows="3" placeholder="Ej: Apartado XXX, especificaciones..."></textarea>
                        </div>

                        <hr>

                        <h2 class="h5 fw-bold mb-3">Método de Pago</h2>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="metodoPago" id="paypal" value="paypal" checked>
                            <label class="form-check-label" for="paypal">
                                <i class="fab fa-paypal text-primary"></i> PayPal
                            </label>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="metodoPago" id="tarjeta" value="tarjeta">
                            <label class="form-check-label" for="tarjeta">
                                <i class="fas fa-credit-card text-danger"></i> Tarjeta de Crédito/Débito
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="metodoPago" id="transferencia" value="transferencia">
                            <label class="form-check-label" for="transferencia">
                                <i class="fas fa-university text-info"></i> Transferencia Bancaria
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="terminos" required>
                            <label class="form-check-label" for="terminos">
                                Acepto los términos y condiciones
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">
                            <i class="fas fa-check-circle"></i> Confirmar Pedido
                        </button>
                        <a href="@Url.Action("Index", "Carrito")" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-light">
                    <h2 class="h5 mb-0">Resumen del Pedido</h2>
                </div>
                <div class="card-body">
                    @{
                        
                        var subtotal = Model.ObtenerTotal();
                        var igv = subtotal * 0.18m;
                        var envio = 10m;
                        var total = subtotal + igv + envio;
                    }

                    @foreach (var item in Model.Items)
                    {
                        var nombre = item.Producto?.Nombre ?? "Producto";
                        var subtotalItem = item.Subtotal;
                        <div class="d-flex justify-content-between mb-2">
                            <span>@nombre x @item.Cantidad</span>
                            <strong>S/ @subtotalItem.ToString("F2")</strong>
                        </div>
                    }

                    <hr>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <strong>S/ @subtotal.ToString("F2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Envío:</span>
                        <strong>S/ @envio.ToString("F2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>IGV (18%):</span>
                        <strong>S/ @igv.ToString("F2")</strong>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <h3 class="h6 fw-bold">Total a Pagar:</h3>
                        <h2 class="h5 text-success fw-bold">S/ @total.ToString("F2")</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>