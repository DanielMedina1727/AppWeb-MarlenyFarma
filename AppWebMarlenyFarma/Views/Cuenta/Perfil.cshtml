@{
    ViewData["Title"] = "Mi Perfil - Botica Marleny Farma";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-user-circle"></i> Mi Perfil</h5>
                </div>
                <div class="card-body">
                    <p><strong>Usuario:</strong> @User.Identity.Name</p>
                    <p><strong>Email:</strong> @User.Identity.Name</p>
                    <hr>
                    <a href="@Url.Action("Logout", "Cuenta")" class="btn btn-danger">Cerrar sesión</a>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>