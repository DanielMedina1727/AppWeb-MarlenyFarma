@model AppWebMarlenyFarma.Controllers.RegistroViewModel

@{
    ViewData["Title"] = "Registrarse - MarlenyFarma";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h2 class="h5 mb-0"><i class="fas fa-user-plus"></i> Crear una Cuenta</h2>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label" for="email">Correo Electrónico*</label>
                            <input type="email" id="email" name="email" class="form-control" autocomplete="email" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="contrasena">Contraseña*</label>
                            <input type="password" id="contrasena" name="contrasena" class="form-control" autocomplete="new-password" required>
                            <small class="text-muted">Mínimo 6 caracteres, incluye números y caracteres especiales</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="confirmarContrasena">Confirmar Contraseña*</label>
                            <input type="password" id="confirmarContrasena" name="confirmarContrasena" class="form-control" autocomplete="new-password" required>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <button type="submit" class="btn btn-success w-100 btn-lg mb-3">
                            Registrarse
                        </button>
                    </form>

                    <hr>

                    <p class="text-center text-muted">
                        ¿Ya tienes cuenta?
                        <a href="@Url.Action("Login", "Cuenta")">Inicia sesión aquí</a>
                    </p>

                    <div class="mt-3">
                        <a href="/" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
