@model AppWebMarlenyFarma.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
    Layout = "_AdminLayout";
}

<div class="card dashboard-card p-4 max-w-700 mx-auto">
    <h5 class="fw-bold mb-4 border-bottom pb-2">
        <i class="fas fa-edit text-success me-2"></i> Modificar Datos del Proveedor
    </h5>

    <form asp-action="EditarProveedor" method="post">
        <!-- Id Oculto -->
        <input type="hidden" asp-for="ProveedorId" />

        <div class="row g-3">
            <partial name="_ProveedorFields" model="Model" />

            <!-- Botones -->
            <div class="col-md-12 d-flex gap-3 justify-content-end mt-4">
                <a href="@Url.Action("Proveedores", "Admin")" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .max-w-700 {
        max-width: 700px;
    }
</style>
