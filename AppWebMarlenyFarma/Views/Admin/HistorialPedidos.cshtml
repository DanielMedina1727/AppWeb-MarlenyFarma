@model IEnumerable<AppWebMarlenyFarma.Models.Pedido>

@{
    ViewData["Title"] = "Historial de Compras y Pedidos";
    Layout = "_AdminLayout";
}

<div class="card dashboard-card p-4">
    <div class="mb-4">
        <h5 class="fw-bold text-secondary">Registro de Transacciones Comerciales</h5>
        <p class="text-muted small">Todos los pedidos realizados por los clientes de la botica, ordenados cronológicamente.</p>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Código Pedido</th>
                    <th>Cliente</th>
                    <th>Contacto (Teléfono/Email)</th>
                    <th>Fecha y Hora</th>
                    <th class="text-end">Total Pagado</th>
                    <th class="text-center">Estado del Pedido</th>
                    <th class="text-center">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var pedido in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@pedido.PedidoId</td>
                            <td>
                                <div class="fw-bold text-dark">@pedido.NombreCliente</div>
                                <span class="text-muted small">Dirección: @pedido.Direccion</span>
                            </td>
                            <td>
                                <div><i class="fas fa-phone-alt text-muted me-1"></i> @pedido.Telefono</div>
                                <div class="small text-muted"><i class="fas fa-envelope text-muted me-1"></i> @pedido.Email</div>
                            </td>
                            <td>
                                <i class="far fa-clock text-muted me-1"></i> @pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end fw-bold text-success">
                                S/ @pedido.Total.ToString("F2")
                            </td>
                            <td class="text-center">
                                @{
                                    var badgeClass = pedido.Estado switch
                                    {
                                        AppWebMarlenyFarma.Models.EstadoPedido.Pendiente => "bg-warning text-dark",
                                        AppWebMarlenyFarma.Models.EstadoPedido.Confirmado => "bg-info text-white",
                                        AppWebMarlenyFarma.Models.EstadoPedido.EnPreparacion => "bg-primary text-white",
                                        AppWebMarlenyFarma.Models.EstadoPedido.Enviado => "bg-secondary text-white",
                                        AppWebMarlenyFarma.Models.EstadoPedido.Entregado => "bg-success text-white",
                                        AppWebMarlenyFarma.Models.EstadoPedido.Cancelado => "bg-danger text-white",
                                        _ => "bg-dark text-white"
                                    };
                                }
                                <span class="badge @badgeClass px-2 py-1">@pedido.Estado</span>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("DetallePedido", "Admin", new { id = pedido.PedidoId })" class="btn btn-sm btn-success">
                                    <i class="fas fa-search-plus"></i> Gestionar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No se registran transacciones de compras.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
