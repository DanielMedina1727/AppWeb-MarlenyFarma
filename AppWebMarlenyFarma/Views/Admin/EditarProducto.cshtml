@model AppWebMarlenyFarma.ViewModels.EditarProductoViewModel

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "_AdminLayout";
}

<div class="card dashboard-card p-4 max-w-800 mx-auto">
    <h5 class="fw-bold mb-4 border-bottom pb-2">
        <i class="fas fa-edit text-success me-2"></i> Editar Detalles del Producto
    </h5>

    <form asp-action="EditarProducto" method="post">
        <input type="hidden" asp-for="ProductoId" />

        <div class="row g-3">
            <partial name="_ProductoFields" model="Model" />

            <div class="col-md-12 d-flex gap-3 justify-content-end mt-4">
                <a href="@Url.Action("Productos", "Admin")"
                   class="btn btn-outline-secondary btn-lg">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .max-w-800 {
        max-width: 800px;
    }
</style>
