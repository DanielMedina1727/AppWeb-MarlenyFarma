@model AppWebMarlenyFarma.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "_AdminLayout";
    var categorias = ViewBag.Categorias as List<AppWebMarlenyFarma.Models.Categoria> ?? new List<AppWebMarlenyFarma.Models.Categoria>();
    var proveedores = ViewBag.Proveedores as List<AppWebMarlenyFarma.Models.Proveedor> ?? new List<AppWebMarlenyFarma.Models.Proveedor>();
}

<div class="card dashboard-card p-4 max-w-800 mx-auto">
    <h5 class="fw-bold mb-4 border-bottom pb-2">
        <i class="fas fa-edit text-success me-2"></i> Editar Detalles del Producto
    </h5>
    
    <form asp-action="EditarProducto" method="post">
        <!-- Id Oculto -->
        <input type="hidden" asp-for="ProductoId" />
        <input type="hidden" asp-for="FechaCreacion" />

        <div class="row g-3">
            <!-- Nombre -->
            <div class="col-md-12">
                <label class="form-label fw-bold">Nombre del Producto*</label>
                <input asp-for="Nombre" class="form-control" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <!-- Descripción -->
            <div class="col-md-12">
                <label class="form-label fw-bold">Descripción*</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <!-- Precio y Precio Original -->
            <div class="col-md-4">
                <label class="form-label fw-bold">Precio Venta (S/)*</label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>
            
            <div class="col-md-4">
                <label class="form-label fw-bold">Precio Original (S/)*</label>
                <input asp-for="PrecioOriginal" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="PrecioOriginal" class="text-danger small"></span>
            </div>

            <!-- Stock -->
            <div class="col-md-4">
                <label class="form-label fw-bold">Stock*</label>
                <input asp-for="Stock" type="number" class="form-control" required />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>

            <!-- Categoría -->
            <div class="col-md-6">
                <label class="form-label fw-bold">Categoría*</label>
                <select asp-for="CategoriaId" class="form-select" required>
                    <option value="">Seleccione una categoría...</option>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.CategoriaId">@cat.Nombre</option>
                    }
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
            </div>

            <!-- Proveedor -->
            <div class="col-md-6">
                <label class="form-label fw-bold">Proveedor</label>
                <select asp-for="ProveedorId" class="form-select">
                    <option value="">Ninguno / Sin proveedor asociado</option>
                    @foreach (var prov in proveedores)
                    {
                        <option value="@prov.ProveedorId">@prov.Nombre (RUC: @prov.Ruc)</option>
                    }
                </select>
                <span asp-validation-for="ProveedorId" class="text-danger small"></span>
            </div>

            <!-- URL de Imagen -->
            <div class="col-md-12">
                <label class="form-label fw-bold">Enlace de Imagen</label>
                <input asp-for="ImagenUrl" class="form-control" placeholder="https://ejemplo.com/imagen.jpg" />
                <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
            </div>

            <!-- Opciones Booleanas (Destacado, Receta) -->
            <div class="col-md-6 form-check py-3 ps-5">
                <input asp-for="EsDestacado" class="form-check-input" type="checkbox" id="EsDestacado" />
                <label class="form-check-label fw-bold" for="EsDestacado">
                    ¿Es Producto Destacado?
                </label>
                <div class="form-text">Aparecerá en el inicio de la tienda principal.</div>
            </div>

            <div class="col-md-6 form-check py-3 ps-5">
                <input asp-for="RequiereReceta" class="form-check-input" type="checkbox" id="RequiereReceta" />
                <label class="form-check-label fw-bold text-danger" for="RequiereReceta">
                    ¿Requiere Receta Médica?
                </label>
                <div class="form-text">Indica si requiere receta médica firmada para su expendio.</div>
            </div>

            <!-- Botones -->
            <div class="col-md-12 d-flex gap-3 justify-content-end mt-4">
                <a href="@Url.Action("Productos", "Admin")" class="btn btn-outline-secondary btn-lg">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .max-w-800 {
        max-width: 800px;
    }
</style>
