@model IEnumerable<AppWebMarlenyFarma.Models.Pedido>

@{
    ViewData["Title"] = "Dashboard de Control";
    Layout = "_AdminLayout";
    
    // Formato de moneda Peruana
    Func<decimal, string> fmtMoneda = (val) => "S/ " + val.ToString("F2");
}

<div class="row g-4 mb-4">
    <!-- Card Ventas Totales -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">Ventas Totales</h6>
                        <h3 class="mb-0 fw-bold text-success">@fmtMoneda(ViewBag.TotalVentas)</h3>
                    </div>
                    <div class="bg-emerald-light p-3 rounded-circle">
                        <i class="fas fa-money-bill-wave fa-2x text-success"></i>
                    </div>
                </div>
                <div class="text-muted small">
                    <span class="text-success fw-bold"><i class="fas fa-arrow-up"></i> Activo</span> pedidos aprobados
                </div>
            </div>
        </div>
    </div>

    <!-- Card Pedidos Recibidos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">Pedidos Totales</h6>
                        <h3 class="mb-0 fw-bold text-dark">@ViewBag.CantidadPedidos</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-shopping-basket fa-2x text-primary"></i>
                    </div>
                </div>
                <div class="text-muted small">
                    <span class="text-primary fw-bold"><i class="fas fa-receipt"></i> Historial</span> total registrados
                </div>
            </div>
        </div>
    </div>

    <!-- Card Clientes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">Clientes</h6>
                        <h3 class="mb-0 fw-bold text-info">@ViewBag.CantidadClientes</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-users-cog fa-2x text-info"></i>
                    </div>
                </div>
                <div class="text-muted small">
                    <span class="text-info fw-bold"><i class="fas fa-user-plus"></i> Activos</span> cuentas de clientes
                </div>
            </div>
        </div>
    </div>

    <!-- Card Alertas Stock -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1 small fw-bold">Stock Crítico</h6>
                        <h3 class="mb-0 fw-bold text-danger">@ViewBag.StockBajoCount</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                    </div>
                </div>
                <div class="text-muted small">
                    <span class="text-danger fw-bold"><i class="fas fa-boxes"></i> Alertas</span> menos de 10 unidades
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card dashboard-card p-4">
            <h5 class="fw-bold mb-3"><i class="fas fa-chart-bar text-success me-2"></i>Nivel de Inventario Crítico</h5>
            <div style="position: relative; height: 300px;">
                <canvas id="bajoStockChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card dashboard-card p-4">
            <h5 class="fw-bold mb-3"><i class="fas fa-chart-pie text-success me-2"></i>Estados de Pedidos</h5>
            <div style="position: relative; height: 300px;">
                <canvas id="estadoPedidosChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Fila Inferior: Pedidos Recientes -->
<div class="row">
    <div class="col-12">
        <div class="card dashboard-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="fas fa-shipping-fast text-success me-2"></i>Pedidos Recientes</h5>
                <a href="@Url.Action("HistorialPedidos", "Admin")" class="btn btn-sm btn-outline-success">Ver todos</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID Pedido</th>
                            <th>Cliente</th>
                            <th>Email</th>
                            <th>Fecha y Hora</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var pedido in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@pedido.PedidoId</td>
                                    <td>@pedido.NombreCliente</td>
                                    <td>@pedido.Email</td>
                                    <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold">@fmtMoneda(pedido.Total)</td>
                                    <td>
                                        @{
                                            var badgeClass = pedido.Estado switch
                                            {
                                                AppWebMarlenyFarma.Models.EstadoPedido.Pendiente => "bg-warning text-dark",
                                                AppWebMarlenyFarma.Models.EstadoPedido.Confirmado => "bg-info text-white",
                                                AppWebMarlenyFarma.Models.EstadoPedido.EnPreparacion => "bg-primary text-white",
                                                AppWebMarlenyFarma.Models.EstadoPedido.Enviado => "bg-secondary text-white",
                                                AppWebMarlenyFarma.Models.EstadoPedido.Entregado => "bg-success text-white",
                                                AppWebMarlenyFarma.Models.EstadoPedido.Cancelado => "bg-danger text-white",
                                                _ => "bg-dark text-white"
                                            };
                                        }
                                        <span class="badge @badgeClass px-2 py-1">@pedido.Estado</span>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("DetallePedido", "Admin", new { id = pedido.PedidoId })" class="btn btn-sm btn-success">
                                            <i class="fas fa-eye"></i> Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No se han registrado pedidos en el sistema.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Serialización segura de datos de ViewBag
        const rawBajoStock = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.BajoStockJson));
        const rawEstados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.EstadosPedidoJson));

        // 1. Gráfico de Bajo Stock
        const ctxBajoStock = document.getElementById('bajoStockChart').getContext('2d');
        new Chart(ctxBajoStock, {
            type: 'bar',
            data: {
                labels: rawBajoStock.map(p => p.Nombre.length > 20 ? p.Nombre.substring(0,20) + '...' : p.Nombre),
                datasets: [{
                    label: 'Stock Actual',
                    data: rawBajoStock.map(p => p.Stock),
                    backgroundColor: 'rgba(220, 53, 69, 0.7)',
                    borderColor: 'rgb(220, 53, 69)',
                    borderWidth: 1,
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Unidades Disponibles'
                        }
                    }
                }
            }
        });

        // 2. Gráfico de Estados de Pedidos
        const ctxEstados = document.getElementById('estadoPedidosChart').getContext('2d');
        new Chart(ctxEstados, {
            type: 'doughnut',
            data: {
                labels: rawEstados.map(e => e.Estado),
                datasets: [{
                    data: rawEstados.map(e => e.Cantidad),
                    backgroundColor: [
                        '#ffc107', // Pendiente
                        '#0dcaf0', // Confirmado
                        '#0d6efd', // EnPreparacion
                        '#6c757d', // Enviado
                        '#198754', // Entregado
                        '#dc3545'  // Cancelado
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}
