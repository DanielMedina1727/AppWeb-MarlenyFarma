@model AppWebMarlenyFarma.ViewModels.ProductoFormViewModel

@{
    var categorias = ViewBag.Categorias as List<AppWebMarlenyFarma.Models.Categoria>
                     ?? new List<AppWebMarlenyFarma.Models.Categoria>();

    var proveedores = ViewBag.Proveedores as List<AppWebMarlenyFarma.Models.Proveedor>
                       ?? new List<AppWebMarlenyFarma.Models.Proveedor>();

    var previewSrc = string.IsNullOrWhiteSpace(Model.ImagenUrl)
                     ? "/images/default-product.svg"
                     : Model.ImagenUrl;

    var isEdit = Model is AppWebMarlenyFarma.ViewModels.EditarProductoViewModel;
}

<div class="col-md-12">
    <label asp-for="Nombre" class="form-label fw-bold">
        Nombre del Producto*
    </label>
    <input asp-for="Nombre" class="form-control"
           placeholder="Ej. Paracetamol 500mg" />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<div class="col-md-12">
    <label asp-for="Descripcion" class="form-label fw-bold">
        Descripción*
    </label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"
              placeholder="Ingresa los componentes, usos u observaciones del producto..."></textarea>
    <span asp-validation-for="Descripcion" class="text-danger small"></span>
</div>

<div class="col-md-4">
    <label asp-for="Precio" class="form-label fw-bold">
        Precio Venta (S/)*
    </label>
    <input asp-for="Precio" type="number" step="0.01"
           class="form-control" placeholder="0.00" />
    <span asp-validation-for="Precio" class="text-danger small"></span>
</div>

<div class="col-md-4">
    <label asp-for="PrecioOriginal" class="form-label fw-bold">
        Precio Original (S/)*
    </label>
    <input asp-for="PrecioOriginal" type="number" step="0.01"
           class="form-control" placeholder="0.00" />
    <span asp-validation-for="PrecioOriginal" class="text-danger small"></span>
</div>

<div class="col-md-4">
    <label asp-for="Stock" class="form-label fw-bold">
        @(isEdit ? "Stock*" : "Stock Inicial*")
    </label>
    <input asp-for="Stock" type="number" class="form-control"
           placeholder="0" />
    <span asp-validation-for="Stock" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="CategoriaId" class="form-label fw-bold">
        Categoría*
    </label>
    <select asp-for="CategoriaId" class="form-select">
        <option value="">Seleccione una categoría...</option>
        @foreach (var cat in categorias)
        {
            <option value="@cat.CategoriaId">@cat.Nombre</option>
        }
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="ProveedorId" class="form-label fw-bold">
        Proveedor
    </label>
    <select asp-for="ProveedorId" class="form-select">
        <option value="">Ninguno / Sin proveedor asociado</option>
        @foreach (var prov in proveedores)
        {
            <option value="@prov.ProveedorId">
                @prov.Nombre (RUC: @prov.Ruc)
            </option>
        }
    </select>
    <span asp-validation-for="ProveedorId" class="text-danger small"></span>
</div>

<div class="col-md-12">
    <label for="inputImagenUrl" class="form-label fw-bold">
        Enlace de Imagen
    </label>

    <input asp-for="ImagenUrl"
           id="inputImagenUrl"
           class="form-control"
           placeholder="https://ejemplo.com/imagen.jpg o /images/..." />

    <span asp-validation-for="ImagenUrl" class="text-danger small"></span>

    <div class="mt-2 d-flex align-items-center gap-3 p-2 bg-light rounded border">
        <img id="previewImagen" src="@previewSrc"
             alt="Vista previa de la imagen del producto"
             class="img-thumbnail"
             style="width: 70px; height: 70px; object-fit: contain; background: #fff;"
             onerror="this.onerror=null; this.src='/images/default-product.svg';" />

        <small class="text-muted">
            Vista previa de la imagen ingresada (se usará la imagen por defecto si se deja en blanco).
        </small>
    </div>
</div>

<div class="col-md-6 form-check py-3 ps-5">
    <input asp-for="EsDestacado" class="form-check-input" />
    <label asp-for="EsDestacado" class="form-check-label fw-bold">
        ¿Es Producto Destacado?
    </label>
    <div class="form-text">
        Aparecerá en el inicio de la tienda principal.
    </div>
    <span asp-validation-for="EsDestacado" class="text-danger small"></span>
</div>

<div class="col-md-6 form-check py-3 ps-5">
    <input asp-for="RequiereReceta" class="form-check-input" />
    <label asp-for="RequiereReceta" class="form-check-label fw-bold text-danger">
        ¿Requiere Receta Médica?
    </label>
    <div class="form-text">
        Indica si requiere receta médica firmada para su expendio.
    </div>
    <span asp-validation-for="RequiereReceta" class="text-danger small"></span>
</div>

<script>
    document.getElementById('inputImagenUrl')?.addEventListener('input', function () {
        var val = this.value.trim();
        var img = document.getElementById('previewImagen');

        if (img) {
            img.src = val || '/images/default-product.svg';
        }
    });
</script>
