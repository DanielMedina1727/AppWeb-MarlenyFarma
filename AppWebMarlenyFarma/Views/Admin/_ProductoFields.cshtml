@model AppWebMarlenyFarma.Models.Producto

@{
    var categorias = ViewBag.Categorias as List<AppWebMarlenyFarma.Models.Categoria>
                     ?? new List<AppWebMarlenyFarma.Models.Categoria>();
    var proveedores = ViewBag.Proveedores as List<AppWebMarlenyFarma.Models.Proveedor>
                      ?? new List<AppWebMarlenyFarma.Models.Proveedor>();
    var previewSrc = Model != null && Model.ProductoId > 0
                     ? Model.ObtenerImagenUrl()
                     : "/images/default-product.svg";
    var isEdit = Model != null && Model.ProductoId > 0;
}

<!-- Nombre -->
<div class="col-md-12">
    <label class="form-label fw-bold" for="Nombre">Nombre del Producto*</label>
    <input asp-for="Nombre" id="Nombre" class="form-control" placeholder="Ej. Paracetamol 500mg" required />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<!-- Descripción -->
<div class="col-md-12">
    <label class="form-label fw-bold" for="Descripcion">Descripción*</label>
    <textarea asp-for="Descripcion" id="Descripcion" class="form-control" rows="3"
              placeholder="Ingresa los componentes, usos u observaciones del producto..." required></textarea>
    <span asp-validation-for="Descripcion" class="text-danger small"></span>
</div>

<!-- Precio y Precio Original -->
<div class="col-md-4">
    <label class="form-label fw-bold" for="Precio">Precio Venta (S/)*</label>
    <input asp-for="Precio" id="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" required />
    <span asp-validation-for="Precio" class="text-danger small"></span>
</div>

<div class="col-md-4">
    <label class="form-label fw-bold" for="PrecioOriginal">Precio Original (S/)*</label>
    <input asp-for="PrecioOriginal" id="PrecioOriginal" type="number" step="0.01" class="form-control" placeholder="0.00" required />
    <span asp-validation-for="PrecioOriginal" class="text-danger small"></span>
</div>

<!-- Stock -->
<div class="col-md-4">
    <label class="form-label fw-bold" for="Stock">@(isEdit ? "Stock*" : "Stock Inicial*")</label>
    <input asp-for="Stock" id="Stock" type="number" class="form-control" placeholder="0" required />
    <span asp-validation-for="Stock" class="text-danger small"></span>
</div>

<!-- Categoría -->
<div class="col-md-6">
    <label class="form-label fw-bold" for="CategoriaId">Categoría*</label>
    <select asp-for="CategoriaId" id="CategoriaId" class="form-select" required>
        <option value="">Seleccione una categoría...</option>
        @foreach (var cat in categorias)
        {
            <option value="@cat.CategoriaId">@cat.Nombre</option>
        }
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
</div>

<!-- Proveedor -->
<div class="col-md-6">
    <label class="form-label fw-bold" for="ProveedorId">Proveedor</label>
    <select asp-for="ProveedorId" id="ProveedorId" class="form-select">
        <option value="">Ninguno / Sin proveedor asociado</option>
        @foreach (var prov in proveedores)
        {
            <option value="@prov.ProveedorId">@prov.Nombre (RUC: @prov.Ruc)</option>
        }
    </select>
    <span asp-validation-for="ProveedorId" class="text-danger small"></span>
</div>

<!-- URL de Imagen -->
<div class="col-md-12">
    <label class="form-label fw-bold" for="inputImagenUrl">Enlace de Imagen</label>
    <input asp-for="ImagenUrl" id="inputImagenUrl" class="form-control" placeholder="https://ejemplo.com/imagen.jpg o /images/..." />
    <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
    <div class="mt-2 d-flex align-items-center gap-3 p-2 bg-light rounded border">
        <img id="previewImagen" src="@previewSrc" alt="Vista previa de la imagen del producto"
             class="img-thumbnail" style="width: 70px; height: 70px; object-fit: contain; background: #fff;"
             onerror="this.onerror=null; this.src='/images/default-product.svg';" />
        <small class="text-muted">Vista previa de la imagen ingresada (se usará la imagen por defecto si se deja en blanco).</small>
    </div>
</div>

<!-- Opciones: Destacado y Receta -->
<div class="col-md-6 form-check py-3 ps-5">
    <input asp-for="EsDestacado" id="EsDestacado" class="form-check-input" type="checkbox" />
    <label class="form-check-label fw-bold" for="EsDestacado">¿Es Producto Destacado?</label>
    <div class="form-text">Aparecerá en el inicio de la tienda principal.</div>
</div>

<div class="col-md-6 form-check py-3 ps-5">
    <input asp-for="RequiereReceta" id="RequiereReceta" class="form-check-input" type="checkbox" />
    <label class="form-check-label fw-bold text-danger" for="RequiereReceta">¿Requiere Receta Médica?</label>
    <div class="form-text">Indica si requiere receta médica firmada para su expendio.</div>
</div>

<script>
    document.getElementById('inputImagenUrl')?.addEventListener('input', function () {
        var val = this.value.trim();
        var img = document.getElementById('previewImagen');
        if (img) {
            img.src = val || '/images/default-product.svg';
        }
    });
</script>
