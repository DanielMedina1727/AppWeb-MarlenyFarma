@model AppWebMarlenyFarma.Models.Proveedor

<!-- Razón Social -->
<div class="col-md-12">
    <label class="form-label fw-bold" for="Nombre">Razón Social / Nombre del Proveedor*</label>
    <input asp-for="Nombre" id="Nombre" class="form-control" placeholder="Ej. Laboratorios Pfizer Perú" required />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>

<!-- RUC y Persona de Contacto -->
<div class="col-md-6">
    <label class="form-label fw-bold" for="Ruc">RUC*</label>
    <input asp-for="Ruc" id="Ruc" class="form-control" placeholder="Ej. 20123456789" required maxlength="11" minlength="11" />
    <span asp-validation-for="Ruc" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label class="form-label fw-bold" for="Contacto">Persona de Contacto</label>
    <input asp-for="Contacto" id="Contacto" class="form-control" placeholder="Ej. Juan Pérez - Gestor de Ventas" />
    <span asp-validation-for="Contacto" class="text-danger small"></span>
</div>

<!-- Teléfono y Correo Electrónico -->
<div class="col-md-6">
    <label class="form-label fw-bold" for="Telefono">Teléfono*</label>
    <input asp-for="Telefono" id="Telefono" class="form-control" placeholder="Ej. 987654321" required />
    <span asp-validation-for="Telefono" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label class="form-label fw-bold" for="Email">Correo Electrónico*</label>
    <input asp-for="Email" id="Email" type="email" class="form-control" placeholder="ventas@proveedor.com" required />
    <span asp-validation-for="Email" class="text-danger small"></span>
</div>

<!-- Dirección -->
<div class="col-md-12">
    <label class="form-label fw-bold" for="Direccion">Dirección Fiscal / Distribuidora</label>
    <input asp-for="Direccion" id="Direccion" class="form-control" placeholder="Ej. Av. El Derby 123, Surco, Lima" />
    <span asp-validation-for="Direccion" class="text-danger small"></span>
</div>
