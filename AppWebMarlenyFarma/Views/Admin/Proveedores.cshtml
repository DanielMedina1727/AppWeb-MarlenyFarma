@model IEnumerable<AppWebMarlenyFarma.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
    Layout = "_AdminLayout";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card dashboard-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0 text-secondary">Proveedores en el Sistema</h5>
        <a href="@Url.Action("CrearProveedor", "Admin")" class="btn btn-success">
            <i class="fas fa-plus"></i> Registrar Proveedor
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Razón Social / Nombre</th>
                    <th>RUC</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Dirección</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var prov in Model)
                    {
                        <tr>
                            <td class="fw-bold text-success">@prov.Nombre</td>
                            <td class="fw-bold">@prov.Ruc</td>
                            <td>@prov.Contacto</td>
                            <td><i class="fas fa-phone-alt text-muted me-1"></i> @prov.Telefono</td>
                            <td><i class="fas fa-envelope text-muted me-1"></i> @prov.Email</td>
                            <td class="small">@prov.Direccion</td>
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a href="@Url.Action("EditarProveedor", "Admin", new { id = prov.ProveedorId })" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    
                                    <form action="@Url.Action("EliminarProveedor", "Admin", new { id = prov.ProveedorId })" method="post" onsubmit="return confirm('¿Está seguro de que desea eliminar este proveedor?')" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No se han registrado proveedores.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
