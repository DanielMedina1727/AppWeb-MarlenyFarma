@model AppWebMarlenyFarma.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
    Layout = "_AdminLayout";
}

<div class="card dashboard-card p-4 max-w-600 mx-auto">
    <h5 class="fw-bold mb-4 border-bottom pb-2">
        <i class="fas fa-edit text-success me-2"></i> Modificar Categoría
    </h5>

    <form asp-action="EditarCategoria" method="post">
        <!-- Id Oculto -->
        <input type="hidden" asp-for="CategoriaId" />

        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label fw-bold">Nombre de la Categoría*</label>
                <input asp-for="Nombre" class="form-control" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="col-md-12">
                <label class="form-label fw-bold">Descripción*</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="col-md-12 d-flex gap-3 justify-content-end mt-4">
                <a href="@Url.Action("Categorias", "Admin")" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .max-w-600 {
        max-width: 600px;
    }
</style>
