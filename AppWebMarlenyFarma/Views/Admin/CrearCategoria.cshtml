@model AppWebMarlenyFarma.Models.Categoria

@{
    ViewData["Title"] = "Crear Nueva Categoría";
    Layout = "_AdminLayout";
}

<div class="card dashboard-card p-4 max-w-600 mx-auto">
    <h5 class="fw-bold mb-4 border-bottom pb-2">
        <i class="fas fa-plus text-success me-2"></i> Detalles de la Categoría
    </h5>

    <form asp-action="CrearCategoria" method="post">
        <div class="row g-3">
            <partial name="_CategoriaFields" model="Model" />

            <div class="col-md-12 d-flex gap-3 justify-content-end mt-4">
                <a href="@Url.Action("Categorias", "Admin")" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Crear Categoría
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .max-w-600 {
        max-width: 600px;
    }
</style>
