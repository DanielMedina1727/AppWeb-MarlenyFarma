@model AppWebMarlenyFarma.Models.Proveedor

@{
    ViewData["Title"] = "Registrar Nuevo Proveedor";
    Layout = "_AdminLayout";
}

<div class="card dashboard-card p-4 max-w-700 mx-auto">
    <h5 class="fw-bold mb-4 border-bottom pb-2">
        <i class="fas fa-plus text-success me-2"></i> Datos del Proveedor
    </h5>

    <form asp-action="CrearProveedor" method="post">
        <div class="row g-3">
            <!-- Razón Social -->
            <div class="col-md-12">
                <label class="form-label fw-bold">Razón Social / Nombre del Proveedor*</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Laboratorios Pfizer Perú" required />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <!-- RUC y Persona de Contacto -->
            <div class="col-md-6">
                <label class="form-label fw-bold">RUC*</label>
                <input asp-for="Ruc" class="form-control" placeholder="Ej. 20123456789" required maxlength="11" minlength="11" />
                <span asp-validation-for="Ruc" class="text-danger small"></span>
            </div>
            
            <div class="col-md-6">
                <label class="form-label fw-bold">Persona de Contacto</label>
                <input asp-for="Contacto" class="form-control" placeholder="Ej. Juan Pérez - Gestor de Ventas" />
                <span asp-validation-for="Contacto" class="text-danger small"></span>
            </div>

            <!-- Teléfono y Correo Electrónico -->
            <div class="col-md-6">
                <label class="form-label fw-bold">Teléfono*</label>
                <input asp-for="Telefono" class="form-control" placeholder="Ej. 987654321" required />
                <span asp-validation-for="Telefono" class="text-danger small"></span>
            </div>
            
            <div class="col-md-6">
                <label class="form-label fw-bold">Correo Electrónico*</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ventas@proveedor.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Dirección -->
            <div class="col-md-12">
                <label class="form-label fw-bold">Dirección Fiscal / Distribuidora</label>
                <input asp-for="Direccion" class="form-control" placeholder="Ej. Av. El Derby 123, Surco, Lima" />
                <span asp-validation-for="Direccion" class="text-danger small"></span>
            </div>

            <!-- Botones -->
            <div class="col-md-12 d-flex gap-3 justify-content-end mt-4">
                <a href="@Url.Action("Proveedores", "Admin")" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Registrar Proveedor
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    .max-w-700 {
        max-width: 700px;
    }
</style>
