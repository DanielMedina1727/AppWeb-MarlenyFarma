@model AppWebMarlenyFarma.ViewModels.CategoriaFormViewModel

<div class="col-md-12">
    <label asp-for="Nombre" class="form-label fw-bold">
        Nombre de la Categoría*
    </label>
    <input asp-for="Nombre"
           class="form-control"
           placeholder="Ej. Antibióticos" />
    <span asp-validation-for="Nombre"
          class="text-danger small"></span>
</div>

<div class="col-md-12">
    <label asp-for="Descripcion" class="form-label fw-bold">
        Descripción*
    </label>
    <textarea asp-for="Descripcion"
              class="form-control"
              rows="3"
              placeholder="Ej. Medicinas para contrarrestar infecciones bacterianas..."></textarea>
    <span asp-validation-for="Descripcion"
          class="text-danger small"></span>
</div>

<div class="col-md-12">
    <label asp-for="ImagenUrl" class="form-label fw-bold">
        URL de imagen
    </label>
    <input asp-for="ImagenUrl"
           class="form-control"
           placeholder="URL de la imagen (opcional)" />
    <span asp-validation-for="ImagenUrl"
          class="text-danger small"></span>
</div>
    