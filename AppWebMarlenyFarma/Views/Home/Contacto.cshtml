@{
    ViewData["Title"] = "Contacto - Botica Marleny Farma";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4 text-center">Contáctanos</h1>
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5><i class="fas fa-map-marker-alt text-success"></i> Dirección</h5>
                    <p>Jr. Conquistadores 163, Cajamarca - Perú</p>
                    <h5><i class="fas fa-phone-alt text-success"></i> Teléfono</h5>
                    <p>+51 928 069 908</p>
                    <h5><i class="fas fa-envelope text-success"></i> Email</h5>
                    <p>atencion@marlenyfarma.com</p>
                    <h5><i class="fas fa-clock text-success"></i> Horario</h5>
                    <p>Lunes a Domingo: 8:00 am - 11:00 pm</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Envíanos un mensaje</h5>
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mensaje</label>
                            <textarea class="form-control" rows="4" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-success">Enviar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>