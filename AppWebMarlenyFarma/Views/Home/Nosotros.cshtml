@{
    ViewData["Title"] = "Nosotros - Botica Marleny Farma";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-6">
            <h1 class="fw-bold mb-4">Sobre Nosotros</h1>
            <p class="lead">En <strong>Botica Marleny Farma</strong>, llevamos más de 10 años brindando salud y bienestar a nuestras familias peruanas.</p>
            <p>Somos una farmacia comprometida con la calidad, la experiencia y la garantía en cada producto que ofrecemos. Nuestro equipo de profesionales está siempre dispuesto a asesorarte y cuidar de tu salud.</p>
            <p><i class="fas fa-check-circle text-success"></i> Productos 100% originales</p>
            <p><i class="fas fa-check-circle text-success"></i> Entrega rápida en Cajamarca</p>
            <p><i class="fas fa-check-circle text-success"></i> Atención personalizada</p>
        </div>
        <div class="col-md-6">
            <img src="~/images/logo-marleny.png" class="img-fluid rounded shadow" alt="Nosotros">
        </div>
    </div>
</div>