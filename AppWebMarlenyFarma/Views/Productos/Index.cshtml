@model List<AppWebMarlenyFarma.Models.Producto>

@{
    ViewData["Title"] = "Productos - MarlenyFarma";
    var categorias = ViewBag.Categorias as List<AppWebMarlenyFarma.Models.Categoria>;
    var categoriaId = ViewBag.CategoriaId as int?;
    var busqueda = ViewBag.Busqueda as string;
    var page = ViewBag.Page as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="container-fluid py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h5 class="fw-bold mb-3">Filtrar</h5>

                <form method="get" action="@Url.Action("Index", "Productos")" class="mb-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Búsqueda</label>
                        <input type="text" name="busqueda" class="form-control" placeholder="Buscar productos..." value="@busqueda">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <select name="categoriaId" class="form-select">
                            <option value="">Todas las categorías</option>
                            @foreach (var cat in categorias ?? new List<AppWebMarlenyFarma.Models.Categoria>())
                            {
                                <option value="@cat.CategoriaId" selected="@(categoriaId == cat.CategoriaId)">@cat.Nombre</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-filter"></i> Filtrar
                    </button>
                </form>

                <hr>

                <h6 class="fw-bold mb-3">Categorías</h6>
                <div class="list-group">
                    @foreach (var cat in categorias ?? new List<AppWebMarlenyFarma.Models.Categoria>())
                    {
                        <a href="@Url.Action("Index", "Productos", new { categoriaId = cat.CategoriaId })"
                           class="list-group-item list-group-item-action @(categoriaId == cat.CategoriaId ? "active" : "")">
                            @cat.Nombre
                        </a>
                    }
                </div>
            </div>

            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold">Productos</h2>
                    <div>
                        @if (!string.IsNullOrEmpty(busqueda) || categoriaId.HasValue)
                        {
                            <span class="badge bg-success me-2">Filtrado: @busqueda @(categoriaId.HasValue ? "Cat: " + categoriaId : "")</span>
                            <a href="@Url.Action("Index", "Productos")" class="btn btn-sm btn-outline-secondary">Limpiar filtros</a>
                        }
                    </div>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="alert alert-info text-center py-5">
                        <i class="fas fa-search display-4 mb-3"></i>
                        <p>No se encontraron productos</p>
                    </div>
                }
                else
                {
                    <div class="row g-4 mb-4">
                        @foreach (var producto in Model)
                        {
                            <div class="col-md-4 col-lg-3">
                                <div class="card h-100 shadow-sm product-card">
                                    <img src="https://via.placeholder.com/250?text=@producto.Nombre.Substring(0, Math.Min(15, producto.Nombre.Length))" class="card-img-top" alt="@producto.Nombre">
                                    <div class="badge bg-danger position-absolute top-0 start-0 m-2">-@((int)((1 - producto.Precio / producto.PrecioOriginal) * 100))%</div>
                                    <div class="card-body d-flex flex-column">
                                        <h6 class="card-title">@producto.Nombre</h6>
                                        <p class="card-text small text-muted flex-grow-1">@producto.Descripcion</p>
                                        @if (producto.RequiereReceta)
                                        {
                                            <small class="badge bg-warning mb-2">Requiere Receta</small>
                                        }
                                        <div class="mb-3">
                                            <span class="h5 text-success">S/ @producto.Precio.ToString("F2")</span>
                                            <br>
                                            <small class="text-muted text-decoration-line-through">S/ @producto.PrecioOriginal.ToString("F2")</small>
                                        </div>
                                        <a href="@Url.Action("Detalle", "Productos", new { id = producto.ProductoId })" class="btn btn-success w-100">
                                            <i class="fas fa-eye"></i> Ver Detalle
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <nav aria-label="Paginación" class="d-flex justify-content-center">
                            <ul class="pagination">
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(page == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", "Productos", new { categoriaId, busqueda, page = i })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>
